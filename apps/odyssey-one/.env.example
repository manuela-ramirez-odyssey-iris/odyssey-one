# ── Shipments API layer ───────────────────────────────────────────────
# 'mock' = load generated SellShipmentOut /details files + map to view-model (default, no API needed).
# 'live' = call the real shipment-service (response mapped SellShipmentOut → view-model).
VITE_API_MODE=mock
# Live base URL or Vite-proxy path (e.g. /odyssey-api). Empty in mock mode.
VITE_API_BASE_URL=
# Temporary dev bearer token for live mode (replaced by MSAL/Entra later).
VITE_API_TOKEN=

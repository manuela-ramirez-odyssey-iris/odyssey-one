# ── Shipments API layer ───────────────────────────────────────────────
# 'mock' = read local generated /details files (default, no access needed).
# 'live' = call the real shipment-service (response mapped SellShipmentOut → view-model).
# 'live-sim' = render the bundled SellShipmentOut fixture through the mapper —
#              proves real-contract rendering without API access (Order tab only for now).
VITE_API_MODE=mock
# Live base URL or Vite-proxy path (e.g. /odyssey-api). Empty in mock mode.
VITE_API_BASE_URL=
# Temporary dev bearer token for live mode (replaced by MSAL/Entra later).
VITE_API_TOKEN=

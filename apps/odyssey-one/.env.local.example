# Odyssey Tracking API integration (POC 1)
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored at the repo root — never commit real credentials.

# Tracking API base. Defaults to production if unset.
VITE_ODYSSEY_TRACKING_API_BASE=https://odyssey-one.com

# JWT bearer token, captured from a logged-in /tracking/dashboard session.
# Capture window: ~10h (per the exp claim). Refresh within 1 hour of any demo.
# Workflow: Safari DevTools → Network → reload → find any
# /api/uiapi/loads/statistics request → right-click → Copy as cURL → extract
# the Authorization: Bearer ... value.
VITE_ODYSSEY_TRACKING_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCIgOiAiSldUIiwia2lkIiA6ICJGQTBHR3RqV0QxSnFTdTFSdTRvWkRCTm5zNWdRTFdHSU9lYi15U0I2dWhvIn0..r9gEsJBk9CzxzHkld36Wu2jrYjVJ1bSfGJhvI0PLfQcvVhRtavdEsx7h8te5oY984P09NM3VP-e_aRcCzcTSpKvFYx6yZlm-RdKTFXT6MwMeAg7IEj2OYOsRkbEz3j7Q5cMNIDolHQMvYDAAzHvuC_ta9V9W9lKYIsfyk9yz5lRxPZV_BT1T3rWzNX8U9Gzz6OIkO_xhJyevcVS7e8LZrxqEtEms3EKw77EXgL7PmuSQptM7cMY2t4yP3CVO245WL1vhPkyNgV2DaPjjYhf0MoRgstGxlH3BNDgPyOPwx6sxXLbXL1Dfj0Auto3ByYcc4aU4ZfRs9zg-oJavqkUDiw


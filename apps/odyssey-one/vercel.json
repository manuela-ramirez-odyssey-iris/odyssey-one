{
  "buildCommand": "node tools/generate.mjs && vite build",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "odyssey-shipments.vercel.app" }],
      "destination": "https://odyssey-one-stage.vercel.app/shipments",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "odyssey-shipments.vercel.app" }],
      "destination": "https://odyssey-one-stage.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__path=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

                <td bgcolor="#f0f0f0" width="20%" valign="top"><b>Sprint:</b></td>
                <td id="customfield_10021-209000-value" class="value" bgcolor="#ffffff" width="80%">Skybreakers Sprint 45</td>
            </tr>
                                <tr>
                <td bgcolor="#f0f0f0" width="20%" valign="top"><b>OdysseyONE Scrum Team:</b></td>
                <td id="customfield_11762-209000-value" class="value" bgcolor="#ffffff" width="80%">    Skybreakers
